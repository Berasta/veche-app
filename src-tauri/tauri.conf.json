{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "veche",
  "version": "0.4.1",
  "identifier": "com.veche.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Вече",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "languages": [
          "Russian",
          "English"
        ],
        "displayLanguageSelector": true
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "veche"
        ]
      }
    },
    "updater": {
      "endpoints": [
        "https://updates.weche.ru/updates/{{target}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGRjhDREY5Q0U2QTJFMQpSV1Rob3VhYzM0ei9CRlNncjdpaGdHQ1JYd25Za1ZuR0Jqb2lSSjI1bkppWTd6YkQ1a1ZzYWErYQo="
    }
  }
}

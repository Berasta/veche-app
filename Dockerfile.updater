FROM node:20-alpine AS builder

WORKDIR /app

# Копируем только package файлы для кеширования
COPY package*.json ./

# Устанавливаем зависимости
RUN npm ci --only=production

FROM node:20-alpine

WORKDIR /app

# Копируем node_modules из builder
COPY --from=builder /app/node_modules ./node_modules

# Копируем updater сервер
COPY server/updater-server.js ./updater-server.js

# Создаем директорию для updates (будет смонтирована через volume)
RUN mkdir -p /app/updates/releases

EXPOSE 3002

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "require('http').get('http://localhost:3002/health', (r) => process.exit(r.statusCode === 200 ? 0 : 1))"

CMD ["node", "updater-server.js"]
